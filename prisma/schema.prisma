generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Company {
  id                    String   @id @default(cuid())
  name                  String
  sector                String   @default("RESTAURANT") // RESTAURANT, RETAIL
  plan                  String   @default("BASIC")
  maxCandidatesPerMonth Int      @default(150)
  phone                 String?
  address               String?
  city                  String   @default("Tuxtla Gutiérrez")
  state                 String   @default("Chiapas")
  country               String   @default("México")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users       User[]
  positions   Position[]
  invitations CandidateInvitation[]
  results     EvaluationResult[]
  interviews  InterviewSchedule[]
  questions   Question[]
  vacancies   Vacancy[]
  vacancyApplications VacancyApplication[]
  privacyNotice CompanyPrivacyNotice?
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  password     String
  role         String    @default("CANDIDATO") // SUPER_ADMIN, RH, GERENTE, CANDIDATO
  phone        String?
  companyId    String?
  active       Boolean   @default(true)
  consentGiven     Boolean   @default(false)
  consentDate      DateTime?
  consentOption    String?   // FULL, KNOWLEDGE_ONLY — which consent option the candidate chose
  anonymousStats   Boolean   @default(false) // Option C: anonymous statistics consent (DEPRECATED — not used in current flow)
  consentConfirmed Boolean   @default(false) // Did candidate confirm reading all options + ARCO?
  consentWithdrawnAt DateTime? // When consent was withdrawn (retracted from FULL to KNOWLEDGE_ONLY)
  consentVersion   String?   // Version of the privacy notice the candidate consented to
  // Retention fields (Phase 3)
  piiPurgeAt       DateTime? // When candidate PII should be purged (2 years after eval)
  sensitivePurgeAt DateTime? // When sensitive data should be purged (on conclusion/withdrawal)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company          Company?              @relation(fields: [companyId], references: [id])
  sessions         EvaluationSession[]
  results          EvaluationResult[]
  sentInvitations  CandidateInvitation[] @relation("InvitationSender")
  interviews       InterviewSchedule[]   @relation("InterviewCandidate")
  consentLogs      ConsentLog[]
  auditLogs        AuditLog[]             @relation("AuditActor")
}

model CompanyPrivacyNotice {
  id          String   @id @default(cuid())
  companyId   String   @unique
  contentHtml String
  version     String   @default("2026-01-v2")
  isCustom    Boolean  @default(false) // true if RH edited the notice
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ConsentLog {
  id              String   @id @default(cuid())
  userId          String
  action          String   // GIVEN, WITHDRAWN, MODIFIED, REVOKED
  previousOption  String?
  newOption       String?
  anonymousStats  Boolean  @default(false)
  consentVersion  String?
  ipAddress       String?
  userAgent       String?  // Browser user-agent string for evidentiary completeness
  companyId       String?  // Tenant context at time of consent
  adminUserId     String?  // If action was performed by an admin (e.g., system override)
  reason          String?  // Optional reason for withdrawal/modification
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Position {
  id               String   @id @default(cuid())
  title            String
  sector           String   @default("RESTAURANT") // RESTAURANT, RETAIL
  category         String   // MESERO, COCINERO, BARTENDER, GERENTE_PISO, VENDEDOR
  description      String?
  hasKnowledgeTest Boolean  @default(false)
  companyId        String
  active           Boolean  @default(true)
  status           String   @default("ACTIVE") // ACTIVE, PAUSED, CLOSED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company             Company               @relation(fields: [companyId], references: [id])
  evaluationTemplates EvaluationTemplate[]
  invitations         CandidateInvitation[]
  sessions            EvaluationSession[]
  results             EvaluationResult[]
  interviews          InterviewSchedule[]
}

model EvaluationTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   // PSICOMETRICA, PSICOLOGICA, CONOCIMIENTOS, INTEGRIDAD
  description String?
  order       Int      @default(1)
  active      Boolean  @default(true)
  positionId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position  Position   @relation(fields: [positionId], references: [id])
  questions Question[]
}

model Question {
  id                   String   @id @default(cuid())
  text                 String
  type                 String   // LIKERT, MULTIPLE_CHOICE, YES_NO
  options              String?  // JSON para opciones de multiple choice
  category             String   // OPENNESS, CONSCIENTIOUSNESS, EXTRAVERSION, AGREEABLENESS, NEUROTICISM, STRESS, EMPATHY, ADAPTABILITY, LEADERSHIP, TEAMWORK, KNOWLEDGE, INTEGRITY_HONESTY, INTEGRITY_RULES, INTEGRITY_THEFT, INTEGRITY_RESPONSIBILITY
  reverseScored        Boolean  @default(false)
  order                Int
  evaluationTemplateId String
  isCustom             Boolean  @default(false)  // true = pregunta personalizada por la empresa
  correctAnswer        Int?     // Índice de la respuesta correcta (0-based) para MULTIPLE_CHOICE
  companyId            String?  // Empresa que creó la pregunta personalizada (null = sistema)
  createdAt            DateTime @default(now())

  evaluationTemplate EvaluationTemplate @relation(fields: [evaluationTemplateId], references: [id], onDelete: Cascade)
  responses          EvaluationResponse[]
  company            Company?           @relation(fields: [companyId], references: [id])
}

model CandidateInvitation {
  id           String   @id @default(cuid())
  candidateName String?
  email        String?
  phone        String?
  token        String   @unique
  status       String   @default("PENDING") // PENDING, REGISTERED, COMPLETED, EXPIRED
  channel      String   @default("WHATSAPP") // EMAIL, WHATSAPP
  companyId    String
  positionId   String
  invitedBy    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  position Position @relation(fields: [positionId], references: [id])
  sender   User     @relation("InvitationSender", fields: [invitedBy], references: [id])
}

model EvaluationSession {
  id                   String    @id @default(cuid())
  candidateId          String
  positionId           String
  companyId            String
  status               String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  currentStep          Int       @default(1) // 1=psicométrica, 2=psicológica, 3=conocimientos
  currentQuestionIndex Int       @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  candidate User                @relation(fields: [candidateId], references: [id])
  position  Position            @relation(fields: [positionId], references: [id])
  responses EvaluationResponse[]
  result    EvaluationResult?
}

model EvaluationResponse {
  id           String   @id @default(cuid())
  sessionId    String
  questionId   String
  value        String
  numericValue Int?
  createdAt    DateTime @default(now())

  session  EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
}

model EvaluationResult {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  candidateId       String
  candidateName     String
  positionId        String
  positionTitle     String
  companyId         String

  // Big Five (0-100)
  openness          Float    @default(0)
  conscientiousness Float    @default(0)
  extraversion      Float    @default(0)
  agreeableness     Float    @default(0)
  neuroticism       Float    @default(0)

  // Psicológica (0-100)
  stressLevel       Float    @default(0)
  empathy           Float    @default(0)
  adaptability      Float    @default(0)
  leadership        Float    @default(0)
  teamwork          Float    @default(0)

  // Conocimientos (0-100, null si no aplica)
  knowledgeScore    Float?

  // Integridad (0-100)
  integrityScore    Float    @default(0)

  // General
  overallScore      Float    @default(0)
  recommendation    String   @default("PENDIENTE") // PERFIL_COMPLETO, PERFIL_PARCIAL, PENDIENTE
  summary           String?

  // Retention fields (Phase 3)
  retainedUntil     DateTime? // When this result should be purged (2 years after createdAt)
  purgedAt          DateTime? // When the result was actually purged/anonymized

  createdAt         DateTime @default(now())

  session           EvaluationSession @relation(fields: [sessionId], references: [id])
  candidate         User              @relation(fields: [candidateId], references: [id])
  position          Position          @relation(fields: [positionId], references: [id])
  company           Company           @relation(fields: [companyId], references: [id])
}

model InterviewSchedule {
  id          String   @id @default(cuid())
  candidateId String
  companyId   String
  positionId  String?
  scheduledAt DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  location    String?
  notes       String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate User     @relation("InterviewCandidate", fields: [candidateId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])
  position  Position? @relation(fields: [positionId], references: [id])
}

model Vacancy {
  id                  String   @id @default(cuid())
  title               String
  slug                String   @unique
  description         String?
  sector              String   @default("GENERAL") // RESTAURANT, RETAIL, GENERAL, etc.
  status              String   @default("ACTIVE") // ACTIVE, PAUSED, CLOSED
  includePsicometrica Boolean  @default(true)
  includePsicologica  Boolean  @default(true)
  includeIntegridad   Boolean  @default(true)
  maxVideoSeconds     Int      @default(60)
  companyId           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company       Company                @relation(fields: [companyId], references: [id])
  questions     VacancyQuestion[]
  applications  VacancyApplication[]
}

model VacancyQuestion {
  id             String   @id @default(cuid())
  text           String
  type           String   // MULTIPLE_CHOICE only for now
  options        String?  // JSON array of options, e.g., '["Opción A","Opción B","Opción C","Opción D"]'
  correctAnswer  Int?     // 0-based index of correct answer
  order          Int
  vacancyId      String
  createdAt      DateTime @default(now())

  vacancy    Vacancy                       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  responses  VacancyApplicationResponse[]
}

model VacancyApplication {
  id                 String    @id @default(cuid())
  vacancyId          String
  companyId          String
  candidateName      String
  candidateEmail     String
  candidatePhone     String?
  candidateAge       Int?
  videoUrl           String?
  videoType          String?   // RECORDED or UPLOADED
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  currentStep        Int       @default(0) // 0=data, 1=psicométrica, 2=psicológica, 3=conocimientos, 4=video, 5=done
  currentQuestionIndex Int     @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Big Five scores (0-100)
  openness           Float     @default(0)
  conscientiousness  Float     @default(0)
  extraversion       Float     @default(0)
  agreeableness      Float     @default(0)
  neuroticism        Float     @default(0)

  // Psychological scores (0-100)
  stressLevel        Float     @default(0)
  empathy            Float     @default(0)
  adaptability       Float     @default(0)
  leadership         Float     @default(0)
  teamwork           Float     @default(0)

  // Knowledge score (0-100, null if no questions)
  knowledgeScore     Float?

  // Integrity score (0-100)
  integrityScore     Float     @default(0)

  // Overall
  overallScore       Float     @default(0)
  recommendation     String    @default("PENDIENTE") // PERFIL_COMPLETO, PERFIL_PARCIAL, PENDIENTE
  summary            String?

  vacancy    Vacancy                      @relation(fields: [vacancyId], references: [id])
  company    Company                      @relation(fields: [companyId], references: [id])
  responses  VacancyApplicationResponse[]
}

model VacancyApplicationResponse {
  id               String   @id @default(cuid())
  applicationId    String
  questionId       String?  // for system questions from EvaluationTemplate
  vacancyQuestionId String? // for custom vacancy questions
  section          String   // PSICOMETRICA, PSICOLOGICA, CONOCIMIENTOS, INTEGRIDAD
  value            String
  numericValue     Int?
  createdAt        DateTime @default(now())

  application     VacancyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vacancyQuestion VacancyQuestion?   @relation(fields: [vacancyQuestionId], references: [id])
}

// AuditLog — Security event log (Phase 1.7)
// Records access, modification, deletion, consent changes, and admin actions.
// NEVER store passwords, tokens, or sensitive values in this table.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // User who performed the action (null = system/anonymous)
  action      String   // LOGIN, LOGOUT, ACCESS, CREATE, UPDATE, DELETE, CONSENT_CHANGE, PERMISSION_CHANGE, ADMIN_ACCESS, UNAUTHORIZED_ATTEMPT
  resource    String?  // Model/table affected (e.g., "User", "EvaluationResult")
  resourceId  String?  // ID of the affected record
  companyId   String?  // Tenant context
  details     String?  // JSON string with additional context (NO secrets)
  ipAddress   String?  // Client IP
  userAgent   String?  // Client user-agent
  success     Boolean  @default(true) // false = failed/unauthorized attempt
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
}
