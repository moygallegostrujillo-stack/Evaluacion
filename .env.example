# ============================================
# CONFIGURACIÓN PARA SUPABASE + VERCEL
# ============================================

# CONEXIÓN POOLER (para consultas de la app en Vercel)
# Usar la URL del Session mode (puerto 5432 en pooler)
DATABASE_URL=postgresql://postgres.USERNAME:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true

# CONEXIÓN DIRECTA (para migraciones de Prisma)
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Seed protection secret (optional, for dev seed endpoint)
SEED_SECRET=your-seed-secret-here
