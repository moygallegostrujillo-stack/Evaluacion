# ============================================
# EVALUHR - Environment Configuration
# ============================================
#
# SECURITY: NEVER commit real secrets to git.
# This file contains PLACEHOLDERS only.
# Copy to .env and fill with real values for local dev.
# In production, set these in Vercel Environment Variables.

# ---- LOCAL DEVELOPMENT (SQLite) ----
DATABASE_URL=file:./prisma/db/custom.db
# JWT_SECRET must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ---- PRODUCTION (Supabase + Vercel) ----
# Set these in Vercel Environment Variables, NOT in .env
#
# DATABASE_URL=postgresql://postgres.USERNAME:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# JWT_SECRET=<strong-random-secret-min-32-chars>

# ---- CRON (Vercel Cron) ----
# Secret used by Vercel Cron to authenticate /api/retention calls
# Generate with: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ---- SEED RESET PROTECTION ----
# Required for /api/seed endpoint to operate (even in dev)
# Generate with: openssl rand -hex 32
EVALUHR_SEED_RESET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ---- SCRIPTS (for local schema/seed operations) ----
# These are read by scripts/apply-supabase-schema.mjs and scripts/seed-supabase-clean.mjs
# DO NOT commit these values. Set them only in your local .env
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-jwt-never-expose-to-client>
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<db-password>
# SUPABASE_DB_NAME=postgres
